# Name of the API. Shown as the title of the interactive docs at /docs.
APP_NAME=volunteer-copilot

# Label for where this instance runs: development, staging or production.
ENVIRONMENT=development

# Path prefix every API route is served under, e.g. /api/v1/health.
API_PREFIX=/api/v1

# Browser origins allowed to call the API (CORS), as a JSON list. Add your
# frontend's URL here; requests from other origins are blocked by the browser.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Keenable web search API key (starts with keen_). Leave empty to use the
# keyless tier: 1,000 requests per hour and 10 per second, shared per IP.
# Set it in production to lift the hourly cap. Get a key at
# https://docs.keenable.ai/api-keys
KEENABLE_API_KEY=
