# Name of the API. Shown as the title of the interactive docs at /docs.
APP_NAME=volunteer-copilot

# Label for where this instance runs: development, staging or production.
ENVIRONMENT=development

# Path prefix every API route is served under, e.g. /api/v1/health.
API_PREFIX=/api/v1

# Browser origins allowed to call the API (CORS), as a JSON list. Add your
# frontend's URL here; requests from other origins are blocked by the browser.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Keenable web search API key (starts with keen_). Leave empty to use the
# keyless tier: 1,000 requests per hour and 10 per second, shared per IP.
# Set it in production to lift the hourly cap. Get a key at
# https://docs.keenable.ai/api-keys
KEENABLE_API_KEY=

# Postgres database for the API and Alembic migrations, which already holds the
# events, roles, users and signups tables. In the Supabase dashboard, click
# Connect and copy the Session pooler URI (port 5432, not the transaction pooler
# on 6543). Paste it here whole, or fill in the line below with the host from
# that URI. Replace Supabase's [YOUR-PASSWORD] placeholder, brackets included,
# with the database password, URL-encoding any special characters.
# `alembic current` checks the connection. Remove this line to use the Supabase
# CLI's local database (`supabase start`).
DATABASE_URL=postgresql://postgres.ddicqlrzqmwtnfjcdynf:YOUR-PASSWORD@YOUR-POOLER-HOST:5432/postgres

# Chert Messaging API signing secret, from the project's sidebar in the Chert
# console (https://console.trychert.com). The backend sends it as a bearer token
# to send iMessages; sending fails until it is set.
# See https://docs.trychert.com/api/quickstart
CHERT_SIGNING_SECRET=

# Secret of the Chert webhook subscription that delivers replies to
# POST /api/v1/chert/webhook. Chert shows it once, when the subscription is
# created, and it is separate from CHERT_SIGNING_SECRET. Until it is set, the
# webhook answers 503 and Chert keeps the events to retry or replay.
CHERT_WEBHOOK_SECRET=
