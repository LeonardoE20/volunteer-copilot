# Demo is standalone and never sends real texts. Copy this file to .env.local.
VITE_DATA_MODE=demo

# Set VITE_DATA_MODE=api to use the backend's actual event/role/user routes.
# The relative URL uses Vite's development proxy, avoiding CORS origin changes.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_EVENT_TIME_ZONE=America/Los_Angeles

# Never put Chert, model, or database secrets in VITE_ variables.
