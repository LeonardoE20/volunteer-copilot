# Copy to .env (never commit .env). Every value is optional:
# with nothing set, the app runs in demo mode (mock AI, data in browser storage).

# --- Browser (Vite exposes only VITE_* vars; never put secrets here) ---
# "local" (default) = demo mode, data in this browser. "remote" = use the Netlify functions + Supabase.
VITE_BACKEND=local

# --- Server only (Netlify environment variables) ---
ANTHROPIC_API_KEY=
# Model names are chosen by the team and set here, never hardcoded. Leave blank to use mock AI.
CLAUDE_MODEL_PARSE=
CLAUDE_MODEL_WRITE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Daily cap on AI calls across the whole site, so a public demo cannot burn the budget.
AI_DAILY_CAP=200
